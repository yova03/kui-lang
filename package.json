{
  "name": "kui-lang",
  "version": "0.1.0",
  "description": "KUI academic Markdown compiler that renders native PDFs without LaTeX.",
  "type": "module",
  "bin": {
    "kui": "./dist/src/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yova03/kui-lang.git"
  },
  "homepage": "https://github.com/yova03/kui-lang#readme",
  "bugs": {
    "url": "https://github.com/yova03/kui-lang/issues"
  },
  "author": "Daril Huaycochea (yova03)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node scripts/copy-fonts.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run check && npm test && npm run build",
    "test": "vitest run",
    "dev": "tsx src/cli/index.ts",
    "gallery": "npm run build && node scripts/build-gallery.mjs",
    "ui": "tsx src/ui/compiler-ui.ts",
    "qa:pdf": "tsx src/pdf/visual-qa.ts",
    "clean": "node scripts/clean.mjs"
  },
  "keywords": [
    "kui",
    "latex",
    "markdown",
    "academic",
    "compiler"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.2",
    "fast-glob": "^3.3.3",
    "pdfkit": "^0.18.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=20"
  }
}
